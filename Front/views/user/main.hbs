            <div class="level filter-item">
                <h3>Level</h3>

                <div class="filter-container">
                    <label class="checkbox-container">
                        <span>Beginner</span>
                        <input class="custom-checkbox" checked="" type="checkbox" name="beginner" id="beginner" value="undefined">
                        <span class="checkmark"></span>
                    </label>

                </div>

                <div class="filter-container">
                    <label class="checkbox-container">
                        <span>Intermediate</span>
                        <input class="custom-checkbox" checked="" type="checkbox" name="intermediate" id="intermediate" value="undefined">
                        <span class="checkmark"></span>
                    </label>
                </div>
            </div>

            <div class="Price filter-item">
                <h3>Price</h3>
                <div class="filter-container">
                    <label class="checkbox-container">
                        <span>Free</span>
                        <input class="custom-checkbox" checked="" type="checkbox" name="free" id="free" value="undefined">
                        <span class="checkmark"></span>
                    </label>                  
                </div>

                <div class="filter-container">
                    <label class="checkbox-container">
                        <span>Paid</span>
                        <input class="custom-checkbox" checked="" type="checkbox" name="paid" id="paid" value="undefined">
                        <span class="checkmark"></span>
                    </label>                   
                </div>                
            </div>

            <div class="Type filter-item">
                <h3>Type</h3>
                <div class="filter-container">
                    <label class="checkbox-container">
                        <span>Career</span>
                        <input class="custom-checkbox" checked="" type="checkbox" name="career" id="career" value="undefined">
                        <span class="checkmark"></span>
                    </label>                
                </div>

                <div class="filter-container">
                    <label class="checkbox-container">
                        <span>Skill</span>
                        <input class="custom-checkbox" checked="" type="checkbox" name="skill" id="skill" value="undefined">
                        <span class="checkmark"></span>
                    </label>               
                </div>          

                <div class="filter-container">
                    <label class="checkbox-container">
                        <span>Course</span>
                        <input class="custom-checkbox" checked="" type="checkbox" name="course" id="course" value="undefined">
                        <span class="checkmark"></span>
                    </label>                
                </div>                
            </div>

            <div class="AvgTime filter-item">
